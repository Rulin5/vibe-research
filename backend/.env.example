# TeaJoin/Tushare-compatible data proxy. Keep the actual value only in .env.
# TeaJoin/Tushare 代理 Key。仅放在 backend/.env 或进程环境中，禁止写入前端和 Git。
TEAJOIN_API_KEY=

# PostgreSQL application database and server-side secrets. Never commit real values.
VR_DATABASE_URL=postgresql+psycopg://vibe_research_app:replace-me@127.0.0.1:5432/vibe_research
VR_TEST_DATABASE_URL=postgresql+psycopg://vibe_test:vibe_test_local_only@127.0.0.1:55432/vibe_research_test
VR_SESSION_SECRET=replace-with-a-random-48-byte-base64-value
VR_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-value
VR_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
VR_ALLOW_ORIGINS=http://127.0.0.1:5899
VR_DEPLOYMENT_MODE=local
VR_COOKIE_SECURE=false
VR_REDIS_URL=
VR_AI_ALLOWED_HOSTS=api.stepfun.com
VR_REPORT_SCAN_COMMAND=

# StepFun is configured server-side. User-specific keys will be added in the authenticated settings flow.
VR_AI_STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
VR_AI_STEPFUN_MODEL=step-3.7-flash
VR_AI_STEPFUN_API_KEY=
