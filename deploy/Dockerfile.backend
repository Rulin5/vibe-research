FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends clamav-daemon \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ /app/backend/
COPY frontend/package.json /app/frontend/package.json
COPY deploy/clamd.remote.conf /etc/clamav/clamd.remote.conf
RUN useradd --system --uid 10001 --create-home appuser \
    && mkdir -p /data/reports \
    && chown -R appuser:appuser /app /data/reports
USER appuser
EXPOSE 8900
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8900", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
